# Backend/local seed configuration. Never put AWS credentials in the Vite .env.
# Lambda should use its execution role. These keys or AWS_PROFILE are for local one-time seeding.
AWS_REGION=ap-south-1
AWS_PROFILE=aquaalert
WATER_SOURCES_TABLE=WaterSources
WATER_READINGS_TABLE=WaterReadings
ALERTS_TABLE=Alerts
RESPONSE_ACTIONS_TABLE=ResponseActions
LAB_REPORTS_TABLE=LabReports
RULES_TABLE=Rules
THRESHOLDS_TABLE=Thresholds
RULES_THRESHOLDS_TABLE=RulesThresholds
EVIDENCE_BUCKET=waterq-dev-evidence-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
